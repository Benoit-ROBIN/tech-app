# Configuration pnpm pour le hoisting
# public-hoist-pattern permet de hoister certaines dépendances vers node_modules racine
public-hoist-pattern[]=*react*
public-hoist-pattern[]=*react-dom*
public-hoist-pattern[]=*@types/react*
public-hoist-pattern[]=*typescript*

# Shamefully-hoist peut être utilisé pour un hoisting complet (comme npm/yarn)
# Mais public-hoist-pattern est plus précis et recommandé
# shamefully-hoist=false

# Stockage des dépendances (par défaut dans ~/.pnpm-store)
# store-dir=.pnpm-store

