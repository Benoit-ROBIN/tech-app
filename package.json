{
  "name": "tech-app",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo pour applications tech avec packages partagés",
  "scripts": {
    "start-nextjs-app": "pnpm --filter './apps/nextjs-app' dev",
    "start-expo-app": "pnpm --filter './apps/expo-app' start",
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "clean": "pnpm --filter './**' clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "husky": "^9.1.7",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@types/react": "^19",
      "typescript": "5.9.2"
    }
  }
}
